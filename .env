# ================================================================
#  Pan-India AQ Engine — Prabhav's Local Environment Config
#  NIT Rourkela | AQ Engine Project
#  ----------------------------------------------------------------
#  This is YOUR filled .env — do not commit this to Git.
#  .env is already listed in .gitignore so you're safe.
#
#  Auth mode  : GEE OAuth (personal Gmail)
#  DB mode    : Docker on localhost (TimescaleDB)
#  GCP Project: aq-engine-project
# ================================================================


# ================================================================
# SECTION 1 — RUNTIME
# ================================================================

# Keep DEBUG while building — gives you full trace logs
# Switch to INFO once things are stable
LOG_LEVEL=DEBUG

# development mode keeps Loguru's variable dumps in tracebacks
# helpful while you're actively debugging modules
APP_ENV=development


# ================================================================
# SECTION 2 — POSTGRESQL + TIMESCALEDB (Docker, localhost)
# ================================================================
# You're running Docker locally, so everything points to localhost.
# Run ./database/setup_db.sh once to spin up the container,
# create the user/db, and apply schema.sql automatically.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=air_quality_db
DB_USER=aq_user
DB_PASS=aq_pass

DATABASE_URL=postgresql+asyncpg://aq_user:aq_pass@localhost:5432/air_quality_db
DATABASE_URL_SYNC=postgresql://aq_user:aq_pass@localhost:5432/air_quality_db

# Connection pool — defaults are fine for local single-user dev
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30


# ================================================================
# SECTION 3 — GOOGLE EARTH ENGINE
# ================================================================
# Auth mode: OAuth (personal Gmail, no service account needed)
# Your GCP project is: aq-engine-project
#
# First-time setup (run ONCE in terminal):
#   conda activate aq_engine
#   python -c "import ee; ee.Authenticate()"
#   → Browser opens → log in with your personal Gmail → Allow
#   → Credentials saved to: ~/.config/earthengine/credentials
#   → After that, ee.Initialize(project='aq-engine-project') just works
#
# You DON'T need a service account — OAuth handles it locally.

# Your GCP project ID (confirmed from screenshot)
EE_PROJECT_ID=aq-engine-project

# Leave both blank — you're using OAuth not a service account
GEE_SERVICE_ACCOUNT=prabhavkhare54@gmail.com
GEE_KEY_FILE=config/gee_key.json

# Keep false once GEE is authenticated.
# Flip to true if you want to test pipeline offline without GEE calls.
USE_MOCK_SATELLITE=false


# ================================================================
# SECTION 4 — OPEN-METEO (Weather Data)
# ================================================================
# Completely free, no key needed — nothing to change here.
# The client hits api.open-meteo.com directly.
# Free tier: ~10,000 requests/day, more than enough for this project.

# OPEN_METEO_API_KEY=   ← leave commented, not needed


# ================================================================
# SECTION 5 — NOMINATIM (Geocoding)
# ================================================================
# Free, no key — just needs a descriptive User-Agent per OSM policy.
# Updated to include your college name as the identifier.

NOMINATIM_USER_AGENT=pan_india_aq_engine/1.0 (prabhav-nitrourkela-research)


# ================================================================
# SECTION 6 — FASTAPI SERVER
# ================================================================
# Running locally — host 0.0.0.0 lets Streamlit reach it on the same machine.

API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=2

# Fresh secret key generated for your project — keep this private
API_SECRET_KEY=d5203b416c0ab62351d0751f8f5884671e8d584911ab561a905384300bd80051

# Streamlit runs on 8501 locally, so allow that origin for CORS
CORS_ORIGINS=http://localhost:8501


# ================================================================
# SECTION 7 — STREAMLIT FRONTEND
# ================================================================
# Streamlit talks to FastAPI at localhost:8000

API_BASE_URL=http://localhost:8000
STREAMLIT_PORT=8501


# ================================================================
# SECTION 8 — ML MODEL PATHS
# ================================================================
# These files won't exist until you run the training scripts.
# Once Module 2 and Module 4 are built, run:
#   python proxy_model/train.py    → generates xgb_pm25_proxy.joblib
#   python forecasting/train.py    → generates lstm_aqi.pt

PROXY_MODEL_PATH=proxy_model/artifacts/xgb_pm25_proxy.joblib
LSTM_CHECKPOINT_PATH=forecasting/checkpoints/lstm_aqi.pt

# How long FastAPI waits for inference before returning a 504
INFERENCE_TIMEOUT_SECONDS=30


# ================================================================
# SECTION 9 — PIPELINE TUNING
# ================================================================
# These are good defaults for city-level AQ research.
# Only change GEE_SAMPLE_SCALE_M if you need finer spatial resolution
# (1000m = 25x more GEE quota usage, not worth it for city-level work).

LOOKBACK_DAYS=7
LSTM_LOOKBACK_HOURS=168
FORECAST_HOURS=24
GEE_SAMPLE_SCALE_M=5000